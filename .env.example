# Base de données (SQLite en local, Postgres recommandé en production - voir README)
DATABASE_URL="file:./dev.db"

# Générez une vraie valeur avec : openssl rand -base64 32
AUTH_SECRET="a-remplacer-par-une-valeur-generee"

# A mettre à true si vous hébergez ailleurs que sur Vercel (VPS, Railway, Render...)
AUTH_TRUST_HOST=true

# URL publique de l'application une fois déployée
NEXTAUTH_URL="https://votre-domaine.com"
