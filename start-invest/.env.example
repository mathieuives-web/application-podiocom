# Base de données (SQLite par défaut)
DATABASE_URL="file:./dev.db"

# Générez une vraie valeur avec : openssl rand -base64 32
# ATTENTION : elle chiffre aussi les identifiants des banques ; la changer oblige à les reconnecter.
AUTH_SECRET="a-remplacer-par-une-valeur-generee"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://votre-domaine.com"

# Dossier des données (base + documents chiffrés). Docker : /app/data (volume persistant à sauvegarder)
DATA_DIR=""
# Double authentification obligatoire pour les actions sensibles (ne pas désactiver en production)
REQUIRE_2FA=""

# Compte fondateur créé au premier lancement (à changer ensuite dans « Accès »)
ADMIN_EMAIL="admin@start-invest.fr"
ADMIN_PASSWORD="startinvest2026"

# Clé API Claude (https://console.anthropic.com) — nécessaire pour convoquer les agents
ANTHROPIC_API_KEY=""

# Synchronisation automatique des banques / logiciels : GET /api/cron/sync
# avec l'en-tête "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=""

# Contrôle quotidien automatique (planificateur intégré) : heure de Paris, défaut 7 h.
DAILY_CONTROL_HOUR=7
# Mettre "off" pour désactiver le planificateur intégré (si vous utilisez /api/cron/daily à la place)
SCHEDULER=""

# Envoi des relances clients par e-mail (n'importe quel fournisseur SMTP : Gmail, OVH, Brevo...)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Comptabilité Start Invest <compta@votre-domaine.fr>"
