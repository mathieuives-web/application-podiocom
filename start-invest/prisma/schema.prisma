generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // tous les droits (fondateur)
  MEMBER // associé, expert-comptable... : consulte, ne modifie pas les connexions ni les accès
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  // Double authentification (code à 6 chiffres d'une application type Google Authenticator)
  totpSecret   String? // chiffré
  totpEnabled  Boolean  @default(false)
}

// Tentatives de connexion (blocage après 5 échecs en 15 minutes)
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// Journal des actions sensibles (connexions, accès bancaires, documents, comptes...)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Finances multi-sociétés (banques, factures, connexions logiciels)
// ---------------------------------------------------------------------------

model Company {
  id             String   @id @default(cuid())
  name           String
  activity       String?
  color          String   @default("#7f1d1d")
  active         Boolean  @default(true)
  // Relances automatiques des factures clients en retard (désactivées tant que non choisies)
  autoReminders  Boolean  @default(false)
  // Présence en ligne (suivie par l'agent Site & réseaux de la société)
  website        String?
  instagram      String?
  facebook       String?
  tiktok         String?
  googleBusiness String?
  linkedin       String?
  createdAt      DateTime @default(now())

  bankAccounts  BankAccount[]
  transactions  BankTransaction[]
  invoices      Invoice[]
  integrations  Integration[]
  documents     Document[]
  statements    FinancialStatement[]
  vehicles      Vehicle[]
  employees     Employee[]
  fieldRequests FieldRequest[]
}

model BankAccount {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name           String
  bank           String?
  iban           String?
  balance        Float     @default(0)
  currency       String    @default("EUR")
  provider       String    @default("MANUAL") // MANUAL | BANQUE | QONTO | STRIPE
  externalId     String?
  // Société choisie automatiquement d'après le nom du compte (tant qu'aucun choix manuel n'a été fait)
  autoAssigned   Boolean   @default(true)
  // Compte exclu du pilotage (ex. compte personnel) : ses opérations ne sont plus importées
  excluded       Boolean   @default(false)
  // COURANT (trésorerie de la société) | SEQUESTRE (fonds de tiers, ex. dépôt-vente) | PRET (emprunt, crédit)
  kind           String    @default("COURANT")
  // Découvert autorisé (ex. 250 000 € garanti par Auxiga sur le stock) et note sur ce financement
  overdraftLimit Float     @default(0)
  financingNote  String?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())

  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  transactions BankTransaction[]

  @@unique([provider, externalId])
}

model BankTransaction {
  id           String      @id @default(cuid())
  accountId    String
  account      BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  date         DateTime
  label        String
  amount       Float // positif = entrée d'argent, négatif = sortie
  category     String?
  counterparty String?
  externalId   String?
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@unique([accountId, externalId])
  @@index([companyId, date])
}

enum InvoiceKind {
  CLIENT
  SUPPLIER
}

model Invoice {
  id                String      @id @default(cuid())
  companyId         String
  company           Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind              InvoiceKind
  number            String?
  counterparty      String
  counterpartyEmail String?
  // true si le logiciel de facturation (ex. Shine Facture) relance déjà lui-même ce client
  externalReminders Boolean     @default(false)
  label             String?
  issueDate         DateTime
  dueDate           DateTime?
  amount            Float // TTC
  paidAmount        Float       @default(0)
  provider          String      @default("MANUAL") // MANUAL | PENNYLANE
  externalId        String?
  createdAt         DateTime    @default(now())

  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  transactions BankTransaction[]
  reminders    Reminder[]

  @@unique([provider, externalId])
  @@index([companyId, kind])
}

model Integration {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider    String // SHINE | QONTO | STRIPE | PENNYLANE
  label       String?
  credentials String // chiffré (AES-256-GCM, clé dérivée de AUTH_SECRET)
  status      String    @default("PENDING") // PENDING | OK | ERROR
  lastSyncAt  DateTime?
  lastError   String?
  meta        String? // informations techniques non sensibles (outils disponibles, champs reçus)
  createdAt   DateTime  @default(now())

  bankAccounts BankAccount[]
  invoices     Invoice[]
}

// ---------------------------------------------------------------------------
// Board d'agents IA : historique des passages (convocations)
// ---------------------------------------------------------------------------

model AgentRun {
  id         String    @id @default(cuid())
  agent      String // slug du fichier .claude/agents/<slug>.md
  task       String
  status     String    @default("RUNNING") // RUNNING | DONE | ERROR
  kind       String    @default("MANUAL") // MANUAL | DAILY (contrôle quotidien automatique)
  companyId  String?
  output     String?
  error      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  userId     String?

  parentId String?
  parent   AgentRun?  @relation("AgentRunTree", fields: [parentId], references: [id], onDelete: Cascade)
  children AgentRun[] @relation("AgentRunTree")

  @@index([agent, startedAt])
}

// Relances clients (niveau 1 = J+3 courtoise, 2 = J+15 ferme, 3 = J+30 dernière relance)
model Reminder {
  id        String    @id @default(cuid())
  invoiceId String
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  level     Int
  to        String?
  subject   String
  body      String
  status    String // SENT | DRAFT (à envoyer à la main) | ERROR
  error     String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@unique([invoiceId, level])
}

// Un passage du contrôle quotidien (un par jour, heure de Paris)
model DailyControl {
  id         String    @id @default(cuid())
  day        String    @unique // AAAA-MM-JJ
  status     String    @default("RUNNING") // RUNNING | DONE | ERROR
  log        String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// Archives : bilans, relevés bancaires et autres documents, stockés chiffrés sur le disque
model Document {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        String // BILAN | RELEVE | FACTURES | AUTRE
  year        Int?
  fileName    String
  mime        String
  size        Int
  sha256      String
  storagePath String
  status      String   @default("PENDING") // PENDING | PROCESSING | DONE | ERROR
  summary     String? // ce que l'IA a extrait / importé
  error       String?
  accountId   String? // pour un relevé : compte bancaire où importer les opérations
  uploadedBy  String?
  createdAt   DateTime @default(now())

  statements FinancialStatement[]

  @@unique([companyId, sha256])
}

// Chiffres clés d'un bilan / compte de résultat (un par société et par exercice)
model FinancialStatement {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  year            Int
  documentId      String?
  document        Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  revenue         Float? // chiffre d'affaires
  grossMargin     Float?
  payroll         Float? // salaires et charges sociales
  ebitda          Float? // EBE
  operatingIncome Float? // résultat d'exploitation
  netIncome       Float? // résultat net
  equity          Float? // capitaux propres
  totalAssets     Float?
  cash            Float? // disponibilités
  debt            Float? // emprunts et dettes financières
  receivables     Float? // créances clients
  payables        Float? // dettes fournisseurs
  stock           Float?
  notes           String? // observations de l'IA (points d'attention)
  createdAt       DateTime  @default(now())

  @@unique([companyId, year])
}

// Mémoire d'un agent : ce qu'il a appris sur sa société, relue à chaque passage et enrichie chaque jour
model AgentMemory {
  id        String   @id @default(cuid())
  agent     String   @unique
  content   String
  updatedAt DateTime @updatedAt
}

// Réglages techniques de l'application (ex. identifiant d'application auprès de Shine)
model AppSetting {
  key   String @id
  value String
}

// Règle de classement : un libellé bancaire « normalisé » -> une catégorie comptable (apprise par l'IA ou corrigée à la main)
model CategoryRule {
  id        String   @id @default(cuid())
  key       String
  companyId String   @default("") // "" = règle valable pour tout le groupe
  category  String
  source    String   @default("IA") // IA | MANUEL
  example   String?
  createdAt DateTime @default(now())

  @@unique([key, companyId])
}

// ------------------------------------------------------------------ véhicules (import Auto Cerfa)
model Vehicle {
  id              String       @id @default(cuid())
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ref             String // n° de stock / livre de police, sinon immatriculation ou VIN
  plate           String?
  vin             String?
  make            String?
  model           String?
  version         String?
  year            Int?
  mileage         Int?
  mode            String       @default("ACHAT") // ACHAT (véhicule acheté) | DEPOT_VENTE (véhicule d'un client)
  status          String       @default("STOCK") // STOCK | VENDU
  entryDate       DateTime?
  purchasePrice   Float? // prix d'achat (ACHAT)
  costs           Float        @default(0) // frais engagés sur le véhicule (préparation, mécanique, carrosserie, CT...)
  costsDetail     String? // JSON [{libelle, montant}]
  askingPrice     Float?
  saleDate        DateTime?
  salePrice       Float?
  sellerPayout    Float? // dépôt-vente : somme reversée au propriétaire
  depotFee        Float? // dépôt-vente : commission gardée par la société
  financingSold   Boolean      @default(false)
  financingIncome Float? // commission de financement perçue par la société
  warrantySold    Boolean      @default(false)
  warrantyPrice   Float?
  buyerName       String? // salarié qui a acheté / rentré le véhicule (tel qu'écrit dans l'export)
  sellerName      String? // salarié qui a vendu
  buyerId         String?
  buyer           Employee?    @relation("VehicleBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId        String?
  seller          Employee?    @relation("VehicleSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  customer        String?
  manualFields    String       @default("") // champs corrigés à la main, jamais écrasés par un nouvel import (liste séparée par des virgules)
  source          String       @default("AUTOCERFA")
  updatedAt       DateTime     @updatedAt
  createdAt       DateTime     @default(now())
  commissions     Commission[]

  @@unique([companyId, ref])
}

// ------------------------------------------------------------------ salariés, commissions, congés
model Employee {
  id                 String    @id @default(cuid())
  companyId          String
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String    @default("")
  role               String? // poste
  email              String?
  phone              String? // format international (33612345678) : reconnaît ses messages WhatsApp
  startDate          DateTime?
  active             Boolean   @default(true)
  grossSalary        Float? // salaire brut mensuel fixe
  // Règles de commission : JSON { ACHAT, VENTE, CREDIT, GARANTIE } -> { mode, valeur, vehicules }, + conditions
  rules              String    @default("{}")
  rulesNote          String? // résumé / conditions particulières du contrat
  leaveDaysPerYear   Float     @default(25)
  contractDocumentId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  fieldRequests FieldRequest[]
  bought        Vehicle[]      @relation("VehicleBuyer")
  sold          Vehicle[]      @relation("VehicleSeller")
  commissions   Commission[]
  leaves        Leave[]

  @@unique([companyId, firstName, lastName])
}

model Commission {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  vehicleId  String?
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  event      String // ACHAT | VENTE | CREDIT | GARANTIE | MANUEL
  month      String // AAAA-MM : mois où la commission est due
  base       Float? // montant sur lequel elle est calculée (marge, prix...)
  amount     Float
  detail     String?
  status     String    @default("A_VERSER") // A_VERSER | VERSE
  paidAt     DateTime?
  warning    String? // donnée manquante ou douteuse à vérifier
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, vehicleId, event])
  @@index([month])
}

model Leave {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  start      DateTime
  end        DateTime
  days       Float
  type       String   @default("CP") // CP | RTT | MALADIE | SANS_SOLDE | AUTRE
  note       String?
  createdAt  DateTime @default(now())
}

// ------------------------------------------------------------------ WhatsApp : demandes du terrain
model FieldRequest {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  fromPhone  String
  fromName   String?
  messageId  String    @unique // identifiant WhatsApp (évite les doublons)
  kind       String    @default("AUTRE") // FRAIS | BESOIN | INTERVENTION | AUTRE
  text       String?
  documentId String? // photo / PDF archivé chiffré
  amount     Float?
  merchant   String?
  spentAt    DateTime?
  vehicle    String? // véhicule ou client concerné si mentionné
  summary    String? // résumé par l'IA
  urgent     Boolean   @default(false)
  status     String    @default("NOUVEAU") // NOUVEAU | TRAITE
  createdAt  DateTime  @default(now())

  @@index([companyId, createdAt])
}

// ------------------------------------------------------------------ projets du fondateur (un agent chef de projet par projet)
model Project {
  id          String   @id @default(cuid())
  name        String   @unique
  description String? // ce qu'est le projet, pour qui, modèle économique
  goal        String? // objectif à atteindre (ex. « lancement public avec paiements réels »)
  repo        String? // dépôt GitHub « propriétaire/nom »
  website     String?
  status      String   @default("EN_COURS") // IDEE | EN_COURS | LANCE | EN_PAUSE
  notes       String? // ce que le fondateur veut que l'agent sache (décisions, contraintes)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
